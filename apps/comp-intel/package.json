{
  "name": "comp-intel",
  "private": true,
  "version": "1.0.0",
  "description": "Source-backed AI compensation intelligence dashboard (observations, not a people database).",
  "type": "module",
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "dev": "node scripts/ingest.mjs && node scripts/serve.mjs",
    "start": "node scripts/ingest.mjs && node scripts/serve.mjs",
    "dev:vite": "node scripts/ingest.mjs && vite",
    "build": "node scripts/ingest.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "verify:ppp": "node scripts/verify-ppp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
