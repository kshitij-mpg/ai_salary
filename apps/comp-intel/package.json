{
  "name": "payrisk-desk",
  "private": true,
  "version": "2.0.0",
  "description": "PayRisk Desk — under/over-pay gap, flight risk, and poach destinations from published AI compensation observations.",
  "type": "module",
  "scripts": {
    "ingest": "node scripts/ingest.mjs",
    "dev": "node scripts/ingest.mjs && vite",
    "start": "node scripts/ingest.mjs && vite",
    "dev:static": "node scripts/ingest.mjs && node scripts/serve.mjs",
    "build": "node scripts/ingest.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "verify:ppp": "node scripts/verify-ppp.mjs",
    "test:ppp": "node scripts/test-ppp-conversion.mjs",
    "test:metric": "node scripts/ingest.mjs && node scripts/test-metric-mode.mjs",
    "test:scenarios": "node scripts/ingest.mjs && node scripts/scenario-test.mjs",
    "test:broad-filters": "node scripts/ingest.mjs && node scripts/test-broad-filters.mjs",
    "validate:market": "node scripts/ingest.mjs && node scripts/validate-market-benchmark.mjs",
    "validate:modes": "node scripts/ingest.mjs && node scripts/validate-mode-benchmarks.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.12",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^6.3.5"
  }
}
